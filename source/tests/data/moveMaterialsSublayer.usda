#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    subLayers = [
        @./moveMaterialsSublayerBinding.usda@
    ]
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Group_A"
    {
        def Scope "Looks"
        {
            def Material "Mat"
            {
                token outputs:surface.connect = </World/Group_A/Looks/Mat/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 0, 0)
                    token outputs:surface
                }
            }
        }

        # MaterialBindingAPI is applied here, but the binding itself is authored in the sublayer.
        def Mesh "CubeA" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-50, 0, -50), (50, 0, 50)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 3, 2]
            point3f[] points = [(-50, 0, -50), (50, 0, -50), (-50, 0, 50), (50, 0, 50)]
            uniform token subdivisionScheme = "none"
        }
    }
}
