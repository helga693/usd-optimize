#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Group_A"
    {
        def Scope "Looks"
        {
            def Material "Mat"
            {
                token outputs:surface.connect = </World/Group_A/Looks/Mat/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 0, 0)
                    token outputs:surface
                }
            }
        }

        def Mesh "CubeA" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-50, 0, -50), (50, 0, 50)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 3, 2]
            rel material:binding = </World/Group_A/Looks/Mat>
            point3f[] points = [(-50, 0, -50), (50, 0, -50), (-50, 0, 50), (50, 0, 50)]
            uniform token subdivisionScheme = "none"
        }
    }

    def Xform "Group_B"
    {
        def Scope "Looks"
        {
            def Material "Mat"
            {
                token outputs:surface.connect = </World/Group_B/Looks/Mat/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 1)
                    token outputs:surface
                }
            }
        }

        def Mesh "CubeB" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-50, 0, -50), (50, 0, 50)]
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 3, 2]
            rel material:binding = </World/Group_B/Looks/Mat>
            point3f[] points = [(-50, 0, -50), (50, 0, -50), (-50, 0, 50), (50, 0, 50)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (200, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

def Xform "Environment"
{
    def Material "EnvMat"
    {
        token outputs:surface.connect = </Environment/EnvMat/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0, 1, 0)
            token outputs:surface
        }
    }

    def Mesh "EnvMesh" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-50, 0, -50), (50, 0, 50)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 3, 2]
        rel material:binding = </Environment/EnvMat>
        point3f[] points = [(-50, 0, -50), (50, 0, -50), (-50, 0, 50), (50, 0, 50)]
        uniform token subdivisionScheme = "none"
    }
}

# Merely starts with an excluded name; it is not an environment rig, so its materials do move.
def Xform "EnvironmentSetup"
{
    def Material "SetupMat"
    {
        token outputs:surface.connect = </EnvironmentSetup/SetupMat/Shader.outputs:surface>

        def Shader "Shader"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 0)
            token outputs:surface
        }
    }

    def Mesh "SetupMesh" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-50, 0, -50), (50, 0, 50)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 3, 2]
        rel material:binding = </EnvironmentSetup/SetupMat>
        point3f[] points = [(-50, 0, -50), (50, 0, -50), (-50, 0, 50), (50, 0, 50)]
        uniform token subdivisionScheme = "none"
    }
}
